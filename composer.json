{
    "name": "yiisoft/router-composer-attribute-collector",
    "type": "library",
    "description": "Router collector from PHP Attributes using composer plugin",
    "keywords": [
        "router", "composer-attribute-collector"
    ],
    "homepage": "https://www.yiiframework.com/",
    "license": "BSD-3-Clause",
    "support": {
        "issues": "https://github.com/yiisoft/router-composer-attribute-collector/issues?state=open",
        "forum": "https://www.yiiframework.com/forum/",
        "wiki": "https://www.yiiframework.com/wiki/",
        "irc": "ircs://irc.libera.chat:6697/yii",
        "chat": "https://t.me/yii3en",
        "source": "https://github.com/yiisoft/router-composer-attribute-collector"
    },
    "funding": [
        {
            "type": "opencollective",
            "url": "https://opencollective.com/yiisoft"
        },
        {
            "type": "github",
            "url": "https://github.com/sponsors/yiisoft"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": "8.1 - 8.5",
        "olvlvl/composer-attribute-collector": "^2.0",
        "yiisoft/router": "dev-add-attributes as 4"
    },
    "require-dev": {
        "nyholm/psr7": "^1.8",
        "phpunit/phpunit": "^10.5.45",
        "psr/http-message": "^2.0",
        "rector/rector": "^2.0.9",
        "roave/infection-static-analysis-plugin": "^1.35",
        "shipmonk/composer-dependency-analyser": "^1.8",
        "spatie/phpunit-watcher": "^1.23",
        "vimeo/psalm": "^5.26.1 || ^6.8.6",
        "yiisoft/code-style": "^1.0",
        "yiisoft/router-fastroute": "^4.0",
        "yiisoft/test-support": "^3.2"
    },
    "autoload": {
        "psr-4": {
            "Yiisoft\\Router\\ComposerAttributeCollector\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Yiisoft\\Router\\ComposerAttributeCollector\\Tests\\": "tests"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "infection/extension-installer": true,
            "olvlvl/composer-attribute-collector": true
        }
    },
    "scripts": {
        "cs-fix": "php-cs-fixer fix",
        "dependency-analyser": "composer-dependency-analyser",
        "infection": "roave-infection-static-analysis-plugin --threads=max",
        "psalm": "psalm",
        "rector": "rector",
        "test": "phpunit --testdox",
        "test-watch": "phpunit-watcher watch"
    }
}
